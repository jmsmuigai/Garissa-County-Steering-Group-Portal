# Copy to .env (same folder) and fill in. Never commit .env or share keys.
# Gemini key from https://aistudio.google.com/apikey - enables the AI assistant, translation and bulletins
GEMINI_API_KEY=
# Falls back to gemini-2.5-flash automatically
GEMINI_MODEL=gemini-2.5-pro
# Optional - https://openweathermap.org/api (Open-Meteo works without a key)
OPENWEATHER_API_KEY=

# Emergency reports -> email (optional). Without SMTP, reports are stored on the server
# and the browser offers a pre-filled email to emergency@garissa.go.ke.
EMERGENCY_EMAIL=emergency@garissa.go.ke
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Read stored reports: curl -H "x-admin-token: <ADMIN_TOKEN>" http://localhost:8080/api/feedback
ADMIN_TOKEN=change-me
PORT=8080
